# Local: BD de docker-compose.dev.yml (pnpm db:up)
DATABASE_URL="postgresql://dragon:dragon@localhost:5433/dragondb"
PORT=3001
NODE_ENV=development
# Mínimo 32 caracteres (el backend no arranca si es más corto)
JWT_SECRET=dev_secret_change_in_production_min32
FRONTEND_URL=https://dragondemadera.com
BOT_TOKEN=your_telegram_bot_token_here
# Obligatorio en producción: el webhook de Telegram lo verifica
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Docker (docker-compose.yml)
POSTGRES_USER=dragondemadera
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=dragondb
APP_PORT=8080

# Solo para el seed inicial (crea admin@dragondemadera.com)
SEED_ADMIN_PASSWORD=
